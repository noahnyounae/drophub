# --- Admin (required) ---
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-to-a-long-password

# --- Cloudflare tunnel: named tunnel token (Zero Trust > Networks > Tunnels) ---
TUNNEL_TOKEN=

# --- Public URL used in generated links (the hostname configured in the tunnel) ---
PUBLIC_URL=https://drop.example.com

# --- Local access (optional) ---
# Host address and port used to reach the app directly, e.g. http://127.0.0.1:3000/admin
# 127.0.0.1 = this machine only; use 0.0.0.0 to expose it on your whole network.
LOCAL_HOST=127.0.0.1
LOCAL_PORT=3000

# Local port ON: docker compose also loads docker-compose.local.yml.
# Local port OFF: delete or comment this line (the app is then reachable through the tunnel only).
COMPOSE_FILE=docker-compose.yml:docker-compose.local.yml

# --- Options ---
# Max file size, in MB
MAX_UPLOAD_MB=2048
# Upload chunk size, in MB (keep below 100: Cloudflare free plan limit)
CHUNK_MB=25
# Admin session lifetime, in hours
SESSION_TTL_HOURS=12
# Minutes of inactivity before an interrupted upload releases the link
LOCK_TTL_MINUTES=10
# false = admin is not reachable through the tunnel (needs the local port ON to reach /admin)
ADMIN_VIA_TUNNEL=true
